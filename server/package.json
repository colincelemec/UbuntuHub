{
  "name": "ubuntuhub-server",
  "version": "2.0.0",
  "description": "Backend API REST pour UbuntuHub Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "prisma migrate deploy && node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "docker:up": "docker-compose up",
    "docker:up:build": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:down:volumes": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:build": "docker-compose build",
    "docker:seed": "docker-compose exec api npm run db:seed",
    "docker:studio": "docker-compose exec api npx prisma studio",
    "db:seed:censimento": "node prisma/seeds/businesses-reali.js",
    "db:init": "prisma migrate deploy && node prisma/seed.js && node prisma/seeds/cities-italia.js && node prisma/seeds/businesses-reali.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:seed:cities": "node prisma/seeds/cities-italia.js",
    "db:migrate:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0_init/migration.sql && prisma migrate resolve --applied 0_init && prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "keywords": [
    "express",
    "api",
    "rest",
    "postgresql",
    "prisma"
  ],
  "author": "UbuntuHub Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "clearMocks": false
  }
}
