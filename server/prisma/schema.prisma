// Prisma schema for the UbuntuHub platform
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

enum UserRole {
  USER          // Regular user
  BUSINESS      // Business owner
  ADMIN         // Administrator
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  phone         String?
  avatar        String?   // Avatar URL
  role          UserRole  @default(USER)
  isVerified    Boolean   @default(false) @map("is_verified")
  googleId      String?   @unique @map("google_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  businesses    Business[]
  reviews       Review[]
  favorites     Favorite[]

  @@map("users")
}

// ============================================
// CITIES & CATEGORIES
// ============================================

model City {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  region      String      // e.g. Lombardia, Lazio
  latitude    Float
  longitude   Float
  description String?
  image       String?     // City picture
  isActive    Boolean     @default(true) @map("is_active")
  order       Int         @default(0) // Display order

  // Relations
  businesses  Business[]

  @@map("cities")
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  icon        String?     // Icon name or URL
  color       String?     // Colour used in the UI
  order       Int         @default(0)
  isActive    Boolean     @default(true) @map("is_active")

  // Relations
  businesses  Business[]

  @@map("categories")
}

// ============================================
// BUSINESSES
// ============================================

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
}

enum BusinessStatus {
  PENDING     // Awaiting a check
  VERIFIED    // Published
  REJECTED    // Rejected
  SUSPENDED   // Suspended
}

model Business {
  id              String            @id @default(cuid())
  ownerId         String            @map("owner_id")
  name            String
  slug            String            @unique
  description     String
  shortDesc       String?           @map("short_desc") // Short description used in lists

  // Location
  cityId          String            @map("city_id")
  address         String
  latitude        Float
  longitude       Float
  zipCode         String?           @map("zip_code")

  // Category
  categoryId      String            @map("category_id")

  // Contact
  phone           String?
  email           String?
  website         String?
  whatsapp        String?

  // Media
  logo            String?           // Logo URL
  coverImage      String?           @map("cover_image")
  images          String[]          // Array of URLs

  // Opening hours (JSON: {monday: {open: "09:00", close: "18:00"}, ...})
  hours           Json?

  // Social networks
  facebook        String?
  instagram       String?
  twitter         String?
  tiktok          String?

  // Business info
  subscriptionTier SubscriptionTier @default(FREE) @map("subscription_tier")
  status          BusinessStatus    @default(PENDING)
  isVerified      Boolean           @default(false) @map("is_verified")
  verifiedAt      DateTime?         @map("verified_at")

  // Stats
  viewCount       Int               @default(0) @map("view_count")
  reviewCount     Int               @default(0) @map("review_count")
  averageRating   Float             @default(0) @map("average_rating")
  favoriteCount   Int               @default(0) @map("favorite_count")

  // SEO
  metaTitle       String?           @map("meta_title")
  metaDescription String?           @map("meta_description")

  // Subscription
  subscriptionEndsAt DateTime?      @map("subscription_ends_at")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  city            City              @relation(fields: [cityId], references: [id])
  category        Category          @relation(fields: [categoryId], references: [id])
  reviews         Review[]
  favorites       Favorite[]

  @@index([cityId])
  @@index([categoryId])
  @@index([status])
  @@index([subscriptionTier])
  @@map("businesses")
}


// ============================================
// REVIEWS & RATINGS
// ============================================

model Review {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  userId      String    @map("user_id")
  rating      Int       // 1-5 stars
  comment     String?
  images      String[]  // Customer photos

  // Owner's reply
  response    String?
  respondedAt DateTime? @map("responded_at")

  // Moderation
  isVisible   Boolean   @default(true) @map("is_visible")
  isReported  Boolean   @default(false) @map("is_reported")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId]) // A user may leave only one review per business
  @@index([businessId])
  @@index([userId])
  @@map("reviews")
}

// ============================================
// FAVOURITES
// ============================================

model Favorite {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  businessId  String    @map("business_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("favorites")
}

// NB: the Payment model (Stripe) was removed together with the
// subscription feature. The SubscriptionTier enum is no longer used
// anywhere in the application: a migration could drop it.
